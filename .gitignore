# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local Databases and backups (Preserved on disk, never committed to git)
*.sqlite3
*.sqlite3-journal
*.sqlite3.bak
*.bak
db.sqlite3*

# Environment and secrets
.env
.env.*
!.env.example

# Virtual Environment
venv/
env/
ENV/
.venv/

# Static collected files (Generated dynamically during deployment)
staticfiles/

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Design and test safety backups
_design_backup*/

# Editor and OS directories
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
