# Ledgerly Environment Variables Example Template
# Duplicate this file as .env for local overrides, or set these in Render Dashboard.

# Django Security Key (Generate a random secret in production)
SECRET_KEY=your-production-secret-key-here

# Debug mode: False for production, True for local development
DEBUG=False

# Allowed hosts (comma-separated, Render automatically populates RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=127.0.0.1,localhost,your-service.onrender.com

# PostgreSQL Database URL provided automatically by Render PostgreSQL
# Example: postgresql://user:password@host:port/dbname
DATABASE_URL=

# CSRF Trusted Origins (comma-separated HTTPS URLs)
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
